# Supabase (required for auth + DB)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard-settings-api

# Replicate Flux
REPLICATE_API_TOKEN=your-replicate-api-token

# xAI (primary) — Grok for LLM tasks. Get key at https://console.x.ai/
# Falls back to Groq when xAI credits/rate limit hit.
# XAI_API_KEY=

# Groq (fallback) — prompt refinement + moderation. Get key at https://console.groq.com/keys
# GROQ_API_KEY=

# Stripe — subscriptions and billing
# Get keys at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Create monthly recurring prices in Stripe Dashboard, then paste the price_xxx IDs:
# STRIPE_PRICE_STARTER=price_xxx   ($2.99/mo — 10 credits)
# STRIPE_PRICE_POPULAR=price_xxx   ($5.99/mo — 25 credits)
# STRIPE_PRICE_PRO=price_xxx       ($9.99/mo — 40 credits)
# Your deployed frontend URL (used for Checkout redirect)
# APP_URL=https://vibeimg.xyz

# Optional: Flux model (default: black-forest-labs/flux-schnell)
# FLUX_MODEL=black-forest-labs/flux-1.1-pro

# Optional: Credits
# CREDITS_PER_GENERATION=1
# DEFAULT_CREDITS_NEW_USER=5

# CORS (comma-separated origins)
# CORS_ORIGINS=http://localhost:8080,https://vibeimg.xyz

# Dev only: allow API without sign-in when frontend sends X-Dev-No-Auth: 1 (e.g. npm run dev)
# Set to 1 or true for local development only. Never enable in production.
# ALLOW_DEV_NO_AUTH=1

# Port (Railway sets PORT)
# PORT=8000
