# Supabase (required for auth + DB)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard-settings-api

# Replicate Flux
REPLICATE_API_TOKEN=your-replicate-api-token

# Groq (free) — prompt refinement + moderation. Get key at https://console.groq.com/keys
# GROQ_API_KEY=

# Optional: Flux model (default: black-forest-labs/flux-schnell)
# FLUX_MODEL=black-forest-labs/flux-1.1-pro

# Optional: Credits
# CREDITS_PER_GENERATION=1
# DEFAULT_CREDITS_NEW_USER=5

# CORS (comma-separated origins)
# CORS_ORIGINS=http://localhost:8080,https://vibeimg.xyz

# Dev only: allow API without sign-in when frontend sends X-Dev-No-Auth: 1 (e.g. npm run dev)
# Set to 1 or true for local development only. Never enable in production.
# ALLOW_DEV_NO_AUTH=1

# Port (Railway sets PORT)
# PORT=8000
